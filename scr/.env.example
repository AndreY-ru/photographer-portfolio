# Образец настроек. Скопируйте в scr/.env и заполните (сам .env в .gitignore).
# На хостинге те же имена задаются в «Setup Python App» → Environment variables.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
FLASK_SECRET_KEY=

# Необязательно: автор в метаданных фото латиницей (иначе — транслит имени из профиля)
# PHOTO_AUTHOR_LATIN=
# Локальная отладка (выключает Secure у кук, включает отладчик Flask)
# FLASK_DEBUG=1
